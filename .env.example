# ---- 飞书 / Lark 企业自建应用 ----
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=
# feishu 或 lark，决定用 feishu.cn 还是 larksuite.com 的接口
FEISHU_BRAND=feishu
# 必须和开发者后台「安全设置 → 重定向 URL」里登记的完全一致
FEISHU_REDIRECT_URI=http://localhost:8765/callback

# ---- Google ----
GOOGLE_SA_KEY_FILE=/etc/feishu-gcal-sync/service-account.json
# 副日历「设置和共享 → 集成日历 → 日历 ID」
GOOGLE_CALENDAR_ID=xxxxxxxxxxxxxxxx@group.calendar.google.com

# ---- 运行状态：飞书 token、告警记录、运行锁 ----
# 本地试跑可以删掉这一行，默认用 ./data
FGS_STATE_DIR=/var/lib/feishu-gcal-sync

# ---- 同步范围 ----
SYNC_PAST_DAYS=7
SYNC_FUTURE_DAYS=60
# 已拒绝的邀请不同步
SKIP_DECLINED=true
# 距离 365 天授权上限还剩多少天开始提醒
REAUTH_WARN_DAYS=14

# ---- Telegram 告警（不填则只写日志）----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 可选：每次同步成功后 GET 这个地址（如 healthchecks.io），用来发现定时任务本身停了 ----
FGS_HEARTBEAT_URL=
